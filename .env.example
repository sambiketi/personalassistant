# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM Provider ---
# One of: deepseek | openai | anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=

# --- Database ---
# Path to the SQLite file (relative to backend/ or absolute)
DB_PATH=focus_agent.db

# --- Server ---
PORT=8000
ENVIRONMENT=development

# --- CORS ---
# Comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGINS=*
