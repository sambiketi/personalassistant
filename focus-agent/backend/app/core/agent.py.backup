import json
import re
import logging
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Any, Tuple
from dataclasses import dataclass, field
from enum import Enum

from app.core.vanguard_brain import VanguardAgentBrain
from app.core.robust_parser import robust_parse_ai_response

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class Intent(Enum):
    CREATE_SCHEDULE = "create_schedule"
    UPDATE_SCHEDULE = "update_schedule"
    HANDLE_EMERGENCY = "handle_emergency"
    SKIP_TASK = "skip_task"
    POSTPONE_TASK = "postpone_task"
    ADD_GOAL = "add_goal"
    UPDATE_GOAL = "update_goal"
    LOG_HABIT = "log_habit"
    LOG_VANGUARD_WIN = "log_vanguard_win"
    LOG_VANGUARD_SKIP = "log_vanguard_skip"
    SHOW_SCHEDULE = "show_schedule"
    SHOW_PROGRESS = "show_progress"
    SHOW_ANALYTICS = "show_analytics"
    GENERAL_CHAT = "general_chat"

@dataclass
class Task:
    id: str
    name: str
    start_time: str
    end_time: str
    duration: int
    priority: int
    status: str
    category: str
    notes: str = ""
    is_flexible: bool = True
    depends_on: List[str] = field(default_factory=list)

@dataclass
class Schedule:
    date: str
    tasks: List[Task]
    total_hours: float = 0
    completion_rate: float = 0
    
    def to_dict(self) -> Dict:
        return {
            'date': self.date,
            'tasks': [{
                'id': t.id,
                'name': t.name,
                'start_time': t.start_time,
                'end_time': t.end_time,
                'duration': t.duration,
                'priority': t.priority,
                'status': t.status,
                'category': t.category,
                'notes': t.notes
            } for t in self.tasks],
            'total_hours': self.total_hours,
            'completion_rate': self.completion_rate
        }
    
    @classmethod
    def from_dict(cls, data: Dict) -> 'Schedule':
        tasks = [Task(**t) for t in data.get('tasks', [])]
        return cls(
            date=data['date'],
            tasks=tasks,
            total_hours=data.get('total_hours', 0),
            completion_rate=data.get('completion_rate', 0)
        )

@dataclass
class AgentResponse:
    intent: Intent
    message: str
    schedule: Optional[Schedule] = None
    action_taken: Optional[Dict] = None
    suggestions: List[str] = field(default_factory=list)
    reasoning: str = ""
    changed_tasks: List[str] = field(default_factory=list)
    vanguard_data: Optional[Dict] = None

class FocusAgent:
    """Main agent engine with Vanguard Brain integration"""
    
    def __init__(self, db, deepseek_service):
        self.db = db
        self.deepseek = deepseek_service
        self.current_schedule: Optional[Schedule] = None
        self.user_id: Optional[str] = None
        self.user_data: Optional[Dict] = None
        self.vanguard_brain: Optional[VanguardAgentBrain] = None
        logger.info("FocusAgent initialized with Vanguard Brain support")
    
    def get_vanguard_brain(self, user_id: str) -> VanguardAgentBrain:
        """Get or create Vanguard Brain for user with DeepSeek LLM integration."""
        if not self.vanguard_brain:
            user_name = self.user_data.get('user_name', 'User') if self.user_data else 'User'
            core_ambition = self.user_data.get('core_ambition', 'Personal Growth') if self.user_data else 'Personal Growth'
            self.vanguard_brain = VanguardAgentBrain(
                user_name=user_name,
                core_ambition=core_ambition,
                starting_block_mins=15,
                deepseek_service=self.deepseek  # ✅ Pass DeepSeek here!
            )
            logger.info(f"🧠 Vanguard Brain created for {user_name} with DeepSeek LLM integration")
        
        return self.vanguard_brain
    
    def process(self, user_id: str, user_input: str) -> AgentResponse:
        """Main entry point - process user input with Vanguard Brain"""
        try:
            logger.info(f"Processing: {user_input[:50]}...")
            
            # Load user context
            self.user_id = user_id
            self.user_data = self.db.get_or_create_user(user_id)
            today = datetime.now().strftime('%Y-%m-%d')
            
            # Get or create Vanguard Brain (now with DeepSeek)
            self.vanguard_brain = self.get_vanguard_brain(user_id)
            
            # Load current schedule
            schedule_data = self.db.get_schedule(self.user_data['id'], today)
            if schedule_data:
                self.current_schedule = Schedule.from_dict(schedule_data)
                logger.info(f"Loaded schedule with {len(self.current_schedule.tasks)} tasks")
            
            # Check for Vanguard Brain specific intents first (ONLY wins and skips)
            intent = self.detect_vanguard_intent(user_input)
            if intent:
                return self.handle_vanguard_intent(intent, user_input)
            
            # Regular intent detection
            intent, entities = self.detect_intent(user_input)
            logger.info(f"Intent detected: {intent.value}")
            
            # Process based on intent
            if intent == Intent.CREATE_SCHEDULE:
                return self.handle_create_schedule(user_input, entities)
            elif intent == Intent.UPDATE_SCHEDULE:
                return self.handle_update_schedule(user_input, entities)
            elif intent == Intent.HANDLE_EMERGENCY:
                return self.handle_emergency(user_input, entities)
            elif intent == Intent.SKIP_TASK:
                return self.handle_skip_task(user_input, entities)
            elif intent == Intent.POSTPONE_TASK:
                return self.handle_postpone_task(user_input, entities)
            elif intent == Intent.ADD_GOAL:
                return self.handle_add_goal(user_input, entities)
            elif intent == Intent.SHOW_SCHEDULE:
                return self.handle_show_schedule()
            elif intent == Intent.SHOW_PROGRESS:
                return self.handle_show_progress()
            elif intent == Intent.SHOW_ANALYTICS:
                return self.handle_show_analytics()
            else:
                return self.handle_general_chat(user_input)
                
        except Exception as e:
            logger.error(f"Error processing: {e}")
            return AgentResponse(
                intent=Intent.GENERAL_CHAT,
                message=f"I encountered an error: {str(e)}. Please try again."
            )
    
    def detect_vanguard_intent(self, user_input: str) -> Optional[Intent]:
        """ONLY detect Vanguard Brain for wins and skips."""
        input_lower = user_input.lower()
        
        if ("completed" in input_lower or "did" in input_lower or "finished" in input_lower) and ("min" in input_lower or "hour" in input_lower or "win" in input_lower):
            return Intent.LOG_VANGUARD_WIN
        
        if ("skip" in input_lower or "didn't" in input_lower or "couldn't" in input_lower) and ("because" in input_lower or "due to" in input_lower):
            return Intent.LOG_VANGUARD_SKIP
        
        return None
    
    def handle_vanguard_intent(self, intent: Intent, user_input: str) -> AgentResponse:
        """Handle Vanguard Brain intents (wins and skips only)."""
        brain = self.vanguard_brain
        
        if intent == Intent.LOG_VANGUARD_WIN:
            # Extract time
            time_spent = 0
            time_match = re.search(r'(\d+)\s*(min|minutes|mins|hour|hours)', user_input.lower())
            if time_match:
                amount = int(time_match.group(1))
                unit = time_match.group(2)
                if unit in ['hour', 'hours']:
                    time_spent = amount * 60
                else:
                    time_spent = amount
            
            result = brain.process_daily_log(
                completed=True,
                time_spent_mins=time_spent or 15,
                user_input=user_input
            )
            
            if self.current_schedule:
                for task in self.current_schedule.tasks:
                    if task.status == 'pending':
                        task.status = 'completed'
                        break
                self.db.save_schedule(
                    self.user_data['id'],
                    self.current_schedule.date,
                    self.current_schedule.to_dict()
                )
            
            return AgentResponse(
                intent=Intent.LOG_VANGUARD_WIN,
                message=result["message"],
                vanguard_data=result["data"],
                suggestions=[],
                reasoning="Vanguard Brain processed win"
            )
        
        elif intent == Intent.LOG_VANGUARD_SKIP:
            # Extract skip reason
            reason = user_input
            if "because" in user_input.lower():
                reason = user_input.lower().split("because")[-1].strip()
            elif "due to" in user_input.lower():
                reason = user_input.lower().split("due to")[-1].strip()
            
            result = brain.process_daily_log(
                completed=False,
                skip_reason=reason[:100],
                user_input=user_input
            )
            
            return AgentResponse(
                intent=Intent.LOG_VANGUARD_SKIP,
                message=result["message"],
                vanguard_data=result["data"],
                suggestions=[],
                reasoning="Vanguard Brain processed skip"
            )
        
        return self.handle_general_chat(user_input)
    
    def detect_intent(self, user_input: str) -> Tuple[Intent, Dict]:
        """Detect user intent with enhanced patterns."""
        input_lower = user_input.lower()
        entities = {}
        
        intent_keywords = {
            Intent.CREATE_SCHEDULE: ['schedule', 'plan', 'tomorrow', 'today', 'wake up', 'morning', 'day', 'my day'],
            Intent.UPDATE_SCHEDULE: ['change', 'move', 'shift', 'adjust', 'update', 'reschedule', 'rearrange'],
            Intent.HANDLE_EMERGENCY: ['emergency', 'urgent', 'critical', 'immediate', 'sudden', 'unexpected', 'panic'],
            Intent.SKIP_TASK: ['skip', 'cancel', 'drop', 'remove', "don't want", 'not doing'],
            Intent.POSTPONE_TASK: ['postpone', 'delay', 'later', 'push back'],
            Intent.ADD_GOAL: ['goal', 'aim', 'objective', 'target', 'want to achieve', 'plan to'],
            Intent.SHOW_SCHEDULE: ['what.*schedule', 'show.*schedule', 'display.*schedule', 'current schedule'],
            Intent.SHOW_PROGRESS: ['progress', 'how am i doing', 'status', 'check in', 'update'],
            Intent.SHOW_ANALYTICS: ['analytics', 'stats', 'statistics', 'summary']
        }
        
        for intent, keywords in intent_keywords.items():
            for keyword in keywords:
                if re.search(keyword, input_lower):
                    if intent == Intent.CREATE_SCHEDULE:
                        entities['text'] = user_input
                    elif intent == Intent.SKIP_TASK or intent == Intent.POSTPONE_TASK:
                        for word in ['workout', 'exercise', 'study', 'code', 'meeting', 'call', 'email', 'project']:
                            if word in input_lower:
                                entities['task'] = word
                                break
                    elif intent == Intent.HANDLE_EMERGENCY:
                        entities['description'] = user_input
                    elif intent == Intent.ADD_GOAL:
                        entities['description'] = user_input
                    
                    return intent, entities
        
        return Intent.GENERAL_CHAT, entities
    
    def handle_create_schedule(self, user_input: str, entities: Dict) -> AgentResponse:
        """Create a new schedule from user description using DeepSeek."""
        today = datetime.now().strftime('%Y-%m-%d')
        wake_time = self.user_data.get('wake_time', '06:00')
        sleep_time = self.user_data.get('sleep_time', '22:00')
        
        prompt = f"""Create a detailed daily schedule based on this user request:
"{user_input}"

User preferences:
- Wake time: {wake_time}
- Sleep time: {sleep_time}
- Current date: {today}

Return ONLY valid JSON with this structure:
{{
    "tasks": [
        {{
            "id": "1",
            "name": "Task name",
            "start_time": "06:00",
            "end_time": "06:30",
            "duration": 30,
            "priority": 3,
            "status": "pending",
            "category": "personal"
        }}
    ],
    "reasoning": "Explanation of the schedule choices",
    "suggestions": ["Tip 1", "Tip 2"]
}}

Categories: work, health, learning, personal
Priority: 1-5 (5 highest)
Time format: HH:MM (24-hour)"""
        
        try:
            logger.info(f"📤 Sending schedule request to DeepSeek...")
            response = self.deepseek.generate(prompt, user_id=self.user_id, 
                                              user_name=self.user_data.get('user_name', 'User'),
                                              core_ambition=self.user_data.get('core_ambition', 'Personal Growth'))
            
            logger.info(f"📥 DeepSeek response received ({len(response)} chars)")
            
            # Use robust parser
            parsed_schedule, error = robust_parse_ai_response(response, today)
            
            if error:
                logger.warning(f"Parser warning: {error}")
                return AgentResponse(
                    intent=Intent.CREATE_SCHEDULE,
                    message=f"Here's your schedule plan:\n\n{response}",
                    schedule=None
                )
            
            if not parsed_schedule or not parsed_schedule.get('tasks'):
                logger.warning("No tasks found in parsed schedule")
                return AgentResponse(
                    intent=Intent.CREATE_SCHEDULE,
                    message=f"I couldn't create a detailed schedule. Here's the plan I received:\n\n{response}",
                    schedule=None
                )
            
            tasks = [Task(**t) for t in parsed_schedule.get('tasks', [])]
            schedule = Schedule(
                date=today,
                tasks=tasks,
                total_hours=parsed_schedule.get('total_hours', 0),
                completion_rate=parsed_schedule.get('completion_rate', 0)
            )
            
            self.db.save_schedule(
                self.user_data['id'],
                today,
                schedule.to_dict()
            )
            
            self.current_schedule = schedule
            
            suggestions = parsed_schedule.get('suggestions', [])
            reasoning = parsed_schedule.get('reasoning', '')
            
            message_parts = [f"✅ Schedule created for {today}!\n\n{self.format_schedule(schedule)}"]
            if reasoning:
                message_parts.append(f"\n📝 {reasoning}")
            if suggestions:
                message_parts.append(f"\n💡 Suggestions: {', '.join(suggestions)}")
            
            return AgentResponse(
                intent=Intent.CREATE_SCHEDULE,
                message="\n".join(message_parts),
                schedule=schedule,
                suggestions=suggestions,
                reasoning=reasoning
            )
                
        except Exception as e:
            logger.error(f"Error creating schedule: {e}")
            return AgentResponse(
                intent=Intent.CREATE_SCHEDULE,
                message=f"I had trouble creating your schedule. Please try again with more details about your day."
            )
    
    def handle_update_schedule(self, user_input: str, entities: Dict) -> AgentResponse:
        """Update existing schedule based on user request."""
        if not self.current_schedule:
            return AgentResponse(
                intent=Intent.UPDATE_SCHEDULE,
                message="No active schedule found. Let me create one for you! 📋"
            )
        
        shift_match = re.search(r'(\d+)\s*(min|hour|hr|minute)', user_input.lower())
        if shift_match:
            amount = int(shift_match.group(1))
            unit = shift_match.group(2)
            if unit in ['hour', 'hr']:
                shift_amount = amount * 60
            else:
                shift_amount = amount
            
            for task in self.current_schedule.tasks:
                start = datetime.strptime(task.start_time, '%H:%M')
                end = datetime.strptime(task.end_time, '%H:%M')
                start = start + timedelta(minutes=shift_amount)
                end = end + timedelta(minutes=shift_amount)
                task.start_time = start.strftime('%H:%M')
                task.end_time = end.strftime('%H:%M')
            
            self.db.save_schedule(
                self.user_data['id'],
                self.current_schedule.date,
                self.current_schedule.to_dict()
            )
            
            return AgentResponse(
                intent=Intent.UPDATE_SCHEDULE,
                message=f"✅ Schedule shifted by {shift_amount} minutes!\n\n{self.format_schedule(self.current_schedule)}",
                schedule=self.current_schedule
            )
        
        return AgentResponse(
            intent=Intent.UPDATE_SCHEDULE,
            message="I can adjust your schedule. What would you like to change?",
            schedule=self.current_schedule
        )
    
    def handle_emergency(self, user_input: str, entities: Dict) -> AgentResponse:
        """Handle emergency task insertion."""
        if not self.current_schedule:
            return AgentResponse(
                intent=Intent.HANDLE_EMERGENCY,
                message="No active schedule. Creating one with the emergency included!"
            )
        
        now = datetime.now()
        current_time = now.strftime('%H:%M')
        
        emergency_task = Task(
            id="emergency",
            name="🚨 URGENT TASK",
            start_time=current_time,
            end_time=(now + timedelta(minutes=60)).strftime('%H:%M'),
            duration=60,
            priority=5,
            status="in_progress",
            category="work"
        )
        
        tasks = []
        inserted = False
        for task in self.current_schedule.tasks:
            if not inserted and task.start_time >= current_time:
                tasks.append(emergency_task)
                inserted = True
            tasks.append(task)
        
        if not inserted:
            tasks.append(emergency_task)
        
        self.current_schedule.tasks = tasks
        self.db.save_schedule(
            self.user_data['id'],
            self.current_schedule.date,
            self.current_schedule.to_dict()
        )
        
        return AgentResponse(
            intent=Intent.HANDLE_EMERGENCY,
            message=f"🚨 Emergency task inserted!\n\n{self.format_schedule(self.current_schedule)}",
            schedule=self.current_schedule
        )
    
    def handle_skip_task(self, user_input: str, entities: Dict) -> AgentResponse:
        """Handle task skipping."""
        if not self.current_schedule:
            return AgentResponse(
                intent=Intent.SKIP_TASK,
                message="No schedule to skip tasks from. Let me create one!"
            )
        
        task_name = entities.get('task', '')
        task_to_skip = None
        
        if task_name:
            for task in self.current_schedule.tasks:
                if task_name in task.name.lower():
                    task_to_skip = task
                    break
        
        if not task_to_skip:
            return AgentResponse(
                intent=Intent.SKIP_TASK,
                message="Which task would you like to skip?"
            )
        
        removed_name = task_to_skip.name
        self.current_schedule.tasks.remove(task_to_skip)
        self.db.save_schedule(
            self.user_data['id'],
            self.current_schedule.date,
            self.current_schedule.to_dict()
        )
        
        return AgentResponse(
            intent=Intent.SKIP_TASK,
            message=f"✅ Skipped '{removed_name}'\n\n{self.format_schedule(self.current_schedule)}",
            schedule=self.current_schedule,
            changed_tasks=[removed_name]
        )
    
    def handle_postpone_task(self, user_input: str, entities: Dict) -> AgentResponse:
        """Handle task postponing."""
        if not self.current_schedule:
            return AgentResponse(
                intent=Intent.POSTPONE_TASK,
                message="No schedule to postpone tasks from."
            )
        
        return AgentResponse(
            intent=Intent.POSTPONE_TASK,
            message="I can help you postpone a task. Please specify which task and when."
        )
    
    def handle_add_goal(self, user_input: str, entities: Dict) -> AgentResponse:
        """Add a new goal."""
        description = entities.get('description', user_input)
        
        goal_data = {
            'title': self._extract_title(user_input),
            'description': description,
            'category': self._detect_category(user_input),
            'priority': 3
        }
        
        goal_id = self.db.create_goal(self.user_data['id'], goal_data)
        
        return AgentResponse(
            intent=Intent.ADD_GOAL,
            message=f"🎯 Goal created: '{goal_data['title']}'\n\nI'll help you track progress on this goal!"
        )
    
    def _extract_title(self, text: str) -> str:
        words = text.split()
        if len(words) <= 5:
            return text
        return ' '.join(words[:5]) + '...'
    
    def _detect_category(self, text: str) -> str:
        text_lower = text.lower()
        if 'health' in text_lower or 'fit' in text_lower or 'workout' in text_lower:
            return 'health'
        elif 'learn' in text_lower or 'study' in text_lower or 'course' in text_lower:
            return 'learning'
        elif 'career' in text_lower or 'job' in text_lower or 'work' in text_lower:
            return 'career'
        return 'personal'
    
    def handle_show_schedule(self) -> AgentResponse:
        """Show current schedule."""
        if not self.current_schedule:
            return AgentResponse(
                intent=Intent.SHOW_SCHEDULE,
                message="No active schedule. Let me create one for you! Just tell me about your day."
            )
        
        return AgentResponse(
            intent=Intent.SHOW_SCHEDULE,
            message=f"📅 Your schedule for {self.current_schedule.date}:\n\n{self.format_schedule(self.current_schedule)}",
            schedule=self.current_schedule
        )
    
    def handle_show_progress(self) -> AgentResponse:
        """Show progress - uses Vanguard Brain for LLM-enhanced response."""
        if self.vanguard_brain:
            # Use Vanguard Brain's LLM-enhanced progress report
            report = self.vanguard_brain.get_progress_report()
            return AgentResponse(
                intent=Intent.SHOW_PROGRESS,
                message=report,
                vanguard_data=self.vanguard_brain.get_stats()
            )
        
        # Fallback to static progress
        goals = self.db.get_goals(self.user_data['id'], 'active')
        patterns = self.db.get_task_patterns(self.user_data['id'])
        habits = self.db.get_habits(self.user_data['id'])
        
        messages = ["📊 Your Progress Report:\n"]
        
        if goals:
            messages.append("🎯 Goals:")
            for goal in goals:
                progress = goal.get('progress', 0)
                bar = self.progress_bar(progress)
                messages.append(f"  {bar} {goal['title']} ({progress:.0f}%)")
            messages.append("")
        
        if habits:
            messages.append("🔥 Habits:")
            for habit in habits:
                streak = habit.get('current_streak', 0)
                messages.append(f"  ✅ {habit['name']} - {streak} day streak")
            messages.append("")
        
        if patterns.get('total', 0) > 0:
            messages.append(f"📈 Completion Rate: {patterns.get('completion_rate', 0):.0f}%")
        
        return AgentResponse(
            intent=Intent.SHOW_PROGRESS,
            message="\n".join(messages)
        )
    
    def handle_show_analytics(self) -> AgentResponse:
        """Show analytics."""
        patterns = self.db.get_task_patterns(self.user_data['id'])
        
        message = f"""
📈 Analytics Summary:

📋 Tasks tracked: {patterns.get('total', 0)}
✅ Completion rate: {patterns.get('completion_rate', 0):.0f}%

Skipped tasks: {len(patterns.get('skipped', []))}
Postponed tasks: {len(patterns.get('postponed', []))}
"""
        
        return AgentResponse(
            intent=Intent.SHOW_ANALYTICS,
            message=message.strip()
        )
    
    def handle_general_chat(self, user_input: str) -> AgentResponse:
        """Handle general conversation with Vanguard Brain context."""
        prompt = f"""User says: "{user_input}"

You are a helpful scheduling assistant with Vanguard Brain integration.
{self.vanguard_brain.get_stats() if self.vanguard_brain else ''}

Respond as a helpful assistant.
Be friendly, concise, and ask clarifying questions if needed."""
        
        response = self.deepseek.generate(prompt, user_id=self.user_id,
                                          user_name=self.user_data.get('user_name', 'User'),
                                          core_ambition=self.user_data.get('core_ambition', 'Personal Growth'))
        
        return AgentResponse(
            intent=Intent.GENERAL_CHAT,
            message=response
        )
    
    def format_schedule(self, schedule: Schedule) -> str:
        """Format schedule for display."""
        if not schedule or not schedule.tasks:
            return "No tasks scheduled."
        
        lines = []
        now = datetime.now().strftime('%H:%M')
        
        for task in schedule.tasks:
            status_icon = {
                'pending': '⚪',
                'in_progress': '🔴',
                'completed': '✅',
                'skipped': '❌',
                'postponed': '⏰'
            }.get(task.status, '⚪')
            
            if task.start_time <= now <= task.end_time and task.status == 'pending':
                task.status = 'in_progress'
                status_icon = '🔴'
            
            if task.status == 'in_progress':
                lines.append(f"🔴 NOW: {task.start_time}-{task.end_time} {task.name}")
            else:
                lines.append(f"{status_icon} {task.start_time}-{task.end_time} {task.name}")
        
        return "\n".join(lines)
    
    def progress_bar(self, progress: float, width: int = 20) -> str:
        """Create ASCII progress bar."""
        filled = int(width * progress / 100)
        bar = '█' * filled + '░' * (width - filled)
        return f"[{bar}]"